
a = mouse_left
b = mouse_right
y = i                           # select paperdoll
x = backspace                   # undo

a_hk = s                        # scroll map
b_hk = d                        # scroll map
y_hk = w                        # scroll map
x_hk = a                        # scroll map
 
l1 = shift                      # shift
l1_hk = t                       # talk

l2 = q                          # reset view
l2_hk = f                       # zoom out

l3 = f10                        # main menu

r1 = mouse_slow                 # mouse slow
r1_hk = `                       # console

r2 = e                          # zoom to active area
r2_hk = r                       # zoom in

select = esc                    # esc
start = enter                   # confirm action
guide = \"

up = up                         # forward
down = down                     # backward
left = left                     # rotate left
right = right                   # rotate right

left_analog_up = mouse_movement_up
left_analog_down = mouse_movement_down
left_analog_left = mouse_movement_left
left_analog_right = mouse_movement_right

right_analog_up = w
right_analog_up = repeat
right_analog_down = s
right_analog_down = repeat
right_analog_left = a
right_analog_left = repeat
right_analog_right = d
right_analog_right = repeat

mouse_slow_scale = 50           # 50%

deadzone_triggers = 3000
mouse_scale = 6114
mouse_delay = 16

deadzone_mode = axial
deadzone = 1000
deadzone_scale = 7
deadzone_delay = 16
